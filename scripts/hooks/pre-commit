#!/bin/sh
# Keeps every commit pushable to GitHub, which refuses any file of 100 MB or more (the "use Git LFS" error).
#   - A commit that adds a fresh Unity data file in dist/Build splits it first (scripts/split-unity-data.ps1)
#     and commits the parts and the updated dist/unity-config.json instead, so a new build can be copied in
#     and committed as it is.
#   - Any other staged file of 100 MB or more stops the commit.
#
# Install once per clone, from the repo folder:  cp scripts/hooks/pre-commit .git/hooks/pre-commit

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

fresh=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=AM -- dist/Build/ |
  grep -E '\.data' | grep -vE '\.part[0-9]+$')
if [ -n "$fresh" ]; then
  echo "pre-commit: splitting the new Unity data file ($fresh) into parts under GitHub's 100 MB limit."
  if command -v powershell.exe >/dev/null 2>&1; then ps=powershell.exe; else ps=pwsh; fi
  "$ps" -NoProfile -ExecutionPolicy Bypass -File scripts/split-unity-data.ps1 ||
    { echo "pre-commit: splitting failed, so nothing was committed." >&2; exit 1; }
  git add -A -- dist/Build dist/unity-config.json || exit 1
fi

limit=104857600
big=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=AM | while IFS= read -r f; do
  size=$(git cat-file -s ":$f" 2>/dev/null) || continue
  [ "$size" -ge "$limit" ] && echo "  $f ($((size / 1048576)) MB)"
done)
if [ -n "$big" ]; then
  echo "pre-commit: GitHub refuses files of 100 MB or more, so this commit would never push:" >&2
  echo "$big" >&2
  echo "Make these files smaller or leave them out of the commit." >&2
  exit 1
fi
exit 0

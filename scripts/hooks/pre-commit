#!/bin/sh
# Stops a commit that GitHub would refuse on push: any staged file of 100 MB or more that isn't stored with
# Git LFS. Files tracked by LFS (see .gitattributes) are staged as small pointers, so they pass.
#
# Install once per clone, from the repo folder:  cp scripts/hooks/pre-commit .git/hooks/pre-commit
# Keep Git LFS's own hooks (git lfs install) next to it: its pre-push hook uploads the LFS files.

limit=104857600
big=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=AM | while IFS= read -r f; do
  size=$(git cat-file -s ":$f" 2>/dev/null) || continue
  [ "$size" -ge "$limit" ] && echo "  $f ($((size / 1048576)) MB)"
done)
if [ -n "$big" ]; then
  echo "pre-commit: GitHub refuses normal files of 100 MB or more, and these aren't stored with Git LFS:" >&2
  echo "$big" >&2
  echo "Track them with Git LFS in .gitattributes (git lfs track), then git add them again." >&2
  exit 1
fi
exit 0

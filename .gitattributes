# The Unity build is stored with Git LFS: GitHub refuses normal files of 100 MB or more, and the data file is bigger.
# Vercel needs Git LFS turned on (Project Settings > Git) to download these files instead of their LFS pointers.
dist/Build/*.gz filter=lfs diff=lfs merge=lfs -text
dist/Build/*.unityweb filter=lfs diff=lfs merge=lfs -text
# Shell hooks break with CRLF line endings, so keep them LF on Windows checkouts too.
scripts/hooks/* text eol=lf

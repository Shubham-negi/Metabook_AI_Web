# The Unity build is stored as normal git files, not Git LFS: the repo's LFS budget ran out, which blocked pushes and
# Vercel's downloads. GitHub refuses normal files over 100 MB, so the big data file is split into parts
# (scripts/split-unity-data.ps1) and player.js joins them again in the browser.
dist/Build/*.unityweb binary
dist/Build/*.part* binary
# Shell hooks break with CRLF line endings, so keep them LF on Windows checkouts too.
scripts/hooks/* text eol=lf
